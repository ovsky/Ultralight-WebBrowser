{
    "id": "midnight",
    "name": "Midnight Blue",
    "description": "Deep blue night theme inspired by GitHub's dark mode",
    "author": "Ultralight Team",
    "version": "1.0.0",
    "isBuiltIn": true,
    "colors": {
        "color-bg-primary": "#0d1117",
        "color-bg-secondary": "#161b22",
