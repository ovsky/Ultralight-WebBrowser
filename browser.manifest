<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity type="win32" name="UltralightWebBrowser" version="0.9.6.0" processorArchitecture="*"/>

  <description>Ultralight Web Browser</description>

  <!--
    Per-monitor v2 is what makes window_->scale() meaningful on a scaled
    display. Without any DPI awareness declared, Windows treats the process as
    DPI-unaware: it renders at 96 DPI and then stretches the finished bitmap to
    the real screen size. Every repaint is a full-surface resample, so scrolling
    gets more expensive the higher the display scale, and text and borders come
    out blurry.

    Per-monitor v2 also routes WM_DPICHANGED so the window can resize itself
    when it is dragged between monitors of different scale, instead of being
    stretched by the compositor.

    ChromiumAware is required on Windows 10 1703+ for per-monitor v2 to be
    honoured rather than silently downgraded.
  -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2, PerMonitor, System</dpiAwareness>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>

  <!-- Declare support for up to Windows 10/11 so newer APIs resolve correctly. -->
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
      <!-- Windows 8.1 -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}"/>
      <!-- Windows 8 -->
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}"/>
      <!-- Windows 7 -->
      <supportedOS Id="{35138b9a-5d96-4fbd-8e2d-a2440225f93a}"/>
    </application>
  </compatibility>

  <dependency>
    <dependentAssembly>
      <assemblyIdentity
          type="win32"
          name="Microsoft.Windows.Common-Controls"
          version="6.0.0.0"
          processorArchitecture="*"
          publicKeyToken="6595b64144ccf1df"
          language="*"/>
    </dependentAssembly>
  </dependency>
</assembly>